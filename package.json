{
  "name": "foxpaw",
  "version": "0.2.0",
  "description": "An oh-my-pi tool that lets an AI agent use the Zen or Firefox you already have open, signed in, over WebDriver BiDi.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nunera/foxpaw.git"
  },
  "type": "module",
  "bin": {
    "foxpaw": "dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./extension": "./extension/zen-browser.ts"
  },
  "files": ["dist", "!dist/bin", "src", "extension", "autoconfig"],
  "omp": {
    "extensions": ["extension/zen-browser.ts"]
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.1"
  },
  "scripts": {
    "check": "bunx tsc --noEmit",
    "test": "bun test",
    "start": "bun run src/cli.ts",
    "broker": "bun run src/cli.ts broker",
    "build:node": "bun scripts/build-node.ts && tsc -p scripts/tsconfig.types.json",
    "build:bin": "bun scripts/build-bin.ts",
    "prepare": "bun scripts/build-node.ts",
    "prepack": "tsc -p scripts/tsconfig.types.json"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  }
}
