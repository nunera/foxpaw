{
  "name": "foxpaw",
  "version": "0.1.0",
  "description": "An oh-my-pi tool that lets an AI agent use the Zen or Firefox you already have open, signed in, over WebDriver BiDi.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nunera/foxpaw.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bunx tsc --noEmit",
    "test": "bun test",
    "start": "bun run src/cli.ts",
    "broker": "bun run src/broker.ts",
    "install-extension": "ln -sfn \"$PWD/extension/zen-browser.ts\" \"$HOME/.omp/agent/extensions/zen-browser.ts\""
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3",
    "zod": "^4.6.4"
  }
}
